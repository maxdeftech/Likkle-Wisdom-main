# Supabase
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# AI - OpenRouter (https://openrouter.ai) - required for AI features
# This app may only use OpenRouter model IDs that explicitly end with ":free".
# Gemini via OpenRouter is allowed only when the exact Gemini model ID ends with ":free".
VITE_OPENROUTER_API_KEY=your_openrouter_key_here

# Legacy alias: VITE_GEMINI_API_KEY is accepted if it starts with sk-or-v1-
# VITE_GEMINI_API_KEY=your_openrouter_key_here

# Web Push
VITE_WEB_PUSH_PUBLIC_KEY=your_vapid_public_key

# To add VITE_OPENROUTER_API_KEY to Vercel:
# 1. Go to vercel.com/dashboard -> your project -> Settings -> Environment Variables
# 2. Click "Add New"
# 3. Name:  VITE_OPENROUTER_API_KEY
# 4. Value: your OpenRouter key
# 5. Environments: check Production, Preview, Development
# 6. Click Save, then redeploy the project
